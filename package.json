{
  "name": "polish-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["cli", "website"],
  "scripts": {
    "build": "bun run cli:build && bun run website:build",
    "test": "bun run cli:test",
    "cli:build": "bun run --filter polish-cli build",
    "cli:test": "bun run --filter polish-cli test",
    "website:dev": "bun run --filter @polish/website dev",
    "website:build": "bun run --filter @polish/website build"
  }
}
